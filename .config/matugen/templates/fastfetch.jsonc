{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/lau/homefiles/avatar.jpg",
      "width": 27,
      "height": 12,
      "padding": {
        "top": 1,
        "bottom": 0,
        "left": 1,
        "right": 2  
      }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}"
    }
  },
  "modules": [
    "title",
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "{{colors.secondary.default.hex}}",
      "format": "{1}"
    },

    {
      "type": "wm",
      "key": "Desktop",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "terminalfont",
      "key": "Font",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },

    "break",
    "colors"
  ]
}
