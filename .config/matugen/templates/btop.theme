# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Title color for boxes
theme[title]="{{colors.primary.default.hex}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{colors.tertiary.default.hex}}"

# Background color of selected item in processes box
theme[selected_bg]="{{colors.primary_container.default.hex}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{colors.outline.default.hex}}"

# Color of graph background lines/borders
theme[proc_misc]="{{colors.outline_variant.default.hex}}"

# Cpu box color gradient
theme[cpu_start]="{{colors.secondary.default.hex}}"
theme[cpu_mid]="{{colors.tertiary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

# Mem/Disk meter colors
theme[free_start]="{{colors.secondary.default.hex}}"
theme[free_mid]="{{colors.tertiary.default.hex}}"
theme[free_end]="{{colors.primary.default.hex}}"

theme[cached_start]="{{colors.secondary.default.hex}}"
theme[cached_mid]="{{colors.tertiary.default.hex}}"
theme[cached_end]="{{colors.primary.default.hex}}"

theme[available_start]="{{colors.secondary.default.hex}}"
theme[available_mid]="{{colors.tertiary.default.hex}}"
theme[available_end]="{{colors.primary.default.hex}}"

theme[used_start]="{{colors.error.default.hex}}"
theme[used_mid]="{{colors.tertiary.default.hex}}"
theme[used_end]="{{colors.primary.default.hex}}"

# Net download/upload graph colors
theme[download_start]="{{colors.secondary.default.hex}}"
theme[download_mid]="{{colors.tertiary.default.hex}}"
theme[download_end]="{{colors.primary.default.hex}}"

theme[upload_start]="{{colors.secondary.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.primary.default.hex}}"