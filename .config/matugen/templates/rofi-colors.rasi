* {
    bg:                       {{colors.surface.default.rgba | set_alpha: 0.5}};
    bg-alt2:		      {{colors.primary_container.default.rgba}};
    bg-alt:                   {{colors.surface_container_high.default.rgba | set_alpha: 0.6}};
    fg:                       {{colors.on_surface.default.hex}};
    accent:                   {{colors.primary.default.rgba | set_alpha: 0.85}};

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-alt2;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            {{colors.on_primary.default.hex}};
}
