    "editorCursor.foreground": "{{colors.primary.default.hex}}",
    "editor.selectionBackground": "{{colors.secondary_container.default.hex}}66",
    "editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}33",
    "editorLineNumber.foreground": "{{colors.outline.default.hex}}",
    "editorLineNumber.activeForeground": "{{colors.on_surface.default.hex}}",

    "activityBar.background": "#00000000",
