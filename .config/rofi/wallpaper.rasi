configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 13";
}

/* Import Matugen dynamic colors */
@import "~/.config/rofi/colors.rasi"

/* Apply Matugen variables to Rofi UI */
window {
    width: 30%;
    border: 4px;
    border-radius: 5px;
    border-color: @selected;
    background-color: @background;
    padding: 0px;
}

mainbox {
    orientation: horizontal;
    background-color: transparent;
    children: [ left-box, right-box ];
    spacing: 0px;
    border-radius: 0px;
}

left-box {
    background-color: transparent;
    background-image: url("~/.cache/rofi_current_wallpaper.png", height);
    expand: true;
}

right-box {
    orientation: vertical;
    background-color: @background-alt2;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 12px;
    expand: true;
    border-radius: 0px;
}

inputbar {
    background-color: transparent;
    text-color: @foreground;
    border-radius: 5px;
    padding: 10px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @selected;
    font: "Bold 10";
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: @foreground;
}

/* One column list: thumbnail on the left, name beside it */
listview {
    background-color: transparent;
    columns: 1;
    lines: 4;
    spacing: 0px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @foreground;
    padding: 5px 10px 5px -12px;
    spacing: 12px;
    border-radius: 5px;
    orientation: horizontal;
}

/* Remove alternating row highlights */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: @selected;
    text-color: @selected-text;
}

/* Small wallpaper thumbnail (change size to taste) */
element-icon {
    background-color: transparent;
    size: 48px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
