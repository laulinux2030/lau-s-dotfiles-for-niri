* {
    bg:                       rgba(18, 19, 24, 0.5);
    bg-alt2:		      rgba(49, 69, 120, 1);
    bg-alt:                   rgba(41, 42, 47, 0.6);
    fg:                       #e3e2e9;
    accent:                   rgba(179, 197, 255, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-alt2;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #192e60;
}
