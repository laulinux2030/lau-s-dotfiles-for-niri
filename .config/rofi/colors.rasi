* {
    bg-dark: 		      #454559;
    bg:                       rgba(19, 19, 24, 0.5);
    bg-alt2:		      rgba(63, 65, 120, 1);
    bg-alt:                   rgba(42, 41, 47, 0.6);
    fg:                       #e4e1e9;
    accent:                   rgba(192, 193, 255, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-dark;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #292a60;
}
