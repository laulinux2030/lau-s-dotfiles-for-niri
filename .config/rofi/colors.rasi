* {
    bg-dark: 		      #5d4034;
    bg:                       rgba(26, 18, 14, 0.5);
    bg-alt2:		      rgba(113, 54, 25, 1);
    bg-alt:                   rgba(50, 40, 36, 0.6);
    fg:                       #f1dfd8;
    accent:                   rgba(255, 181, 149, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-dark;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #542105;
}
