* {
    bg-dark: 		      #384956;
    bg:                       rgba(16, 20, 23, 0.5);
    bg-alt2:		      rgba(0, 76, 110, 1);
    bg-alt:                   rgba(38, 42, 46, 0.6);
    fg:                       #dfe3e8;
    accent:                   rgba(148, 205, 247, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-dark;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #00344d;
}
