* {
    bg-dark: 		      #1a1111;
    bg:                       rgba(26, 17, 17, 0.5);
    bg-alt2:		      rgba(115, 51, 50, 1);
    bg-alt:                   rgba(50, 40, 39, 0.6);
    fg:                       #f0dedd;
    accent:                   rgba(255, 179, 176, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-dark;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #571d1e;
}
