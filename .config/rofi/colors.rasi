* {
    bg:                       rgba(14, 20, 21, 0.5);
    bg-alt2:		      rgba(0, 79, 82, 1);
    bg-alt:                   rgba(37, 43, 43, 0.6);
    fg:                       #dde4e3;
    accent:                   rgba(128, 212, 216, 0.85);

    background:               @bg;
    background-alt:           @bg-alt;
    background-alt2:	      @bg-alt2;
    foreground:               @fg;
    selected:                 @accent;
    selected-text:            #003739;
}
