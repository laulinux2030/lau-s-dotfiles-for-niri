# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#dde4e3"

# Title color for boxes
theme[title]="#80d4d8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b5c7e9"

# Background color of selected item in processes box
theme[selected_bg]="#004f52"

# Foreground color of selected item in processes box
theme[selected_fg]="#9cf1f4"

# Color of inactive/disabled text
theme[inactive_fg]="#899393"

# Color of graph background lines/borders
theme[proc_misc]="#3f4949"

# Cpu box color gradient
theme[cpu_start]="#b0cccd"
theme[cpu_mid]="#b5c7e9"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#b0cccd"
theme[free_mid]="#b5c7e9"
theme[free_end]="#80d4d8"

theme[cached_start]="#b0cccd"
theme[cached_mid]="#b5c7e9"
theme[cached_end]="#80d4d8"

theme[available_start]="#b0cccd"
theme[available_mid]="#b5c7e9"
theme[available_end]="#80d4d8"

theme[used_start]="#ffb4ab"
theme[used_mid]="#b5c7e9"
theme[used_end]="#80d4d8"

# Net download/upload graph colors
theme[download_start]="#b0cccd"
theme[download_mid]="#b5c7e9"
theme[download_end]="#80d4d8"

theme[upload_start]="#b0cccd"
theme[upload_mid]="#b5c7e9"
theme[upload_end]="#80d4d8"