# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#e3e3d8"

# Title color for boxes
theme[title]="#b6d086"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a0d0c9"

# Background color of selected item in processes box
theme[selected_bg]="#394d12"

# Foreground color of selected item in processes box
theme[selected_fg]="#d2ec9f"

# Color of inactive/disabled text
theme[inactive_fg]="#8f9284"

# Color of graph background lines/borders
theme[proc_misc]="#45483d"

# Cpu box color gradient
theme[cpu_start]="#c1caab"
theme[cpu_mid]="#a0d0c9"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#c1caab"
theme[free_mid]="#a0d0c9"
theme[free_end]="#b6d086"

theme[cached_start]="#c1caab"
theme[cached_mid]="#a0d0c9"
theme[cached_end]="#b6d086"

theme[available_start]="#c1caab"
theme[available_mid]="#a0d0c9"
theme[available_end]="#b6d086"

theme[used_start]="#ffb4ab"
theme[used_mid]="#a0d0c9"
theme[used_end]="#b6d086"

# Net download/upload graph colors
theme[download_start]="#c1caab"
theme[download_mid]="#a0d0c9"
theme[download_end]="#b6d086"

theme[upload_start]="#c1caab"
theme[upload_mid]="#a0d0c9"
theme[upload_end]="#b6d086"