# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#eee0d5"

# Title color for boxes
theme[title]="#faba72"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#bdcd9c"

# Background color of selected item in processes box
theme[selected_bg]="#673d00"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffddbb"

# Color of inactive/disabled text
theme[inactive_fg]="#9d8e81"

# Color of graph background lines/borders
theme[proc_misc]="#50453a"

# Cpu box color gradient
theme[cpu_start]="#e0c1a3"
theme[cpu_mid]="#bdcd9c"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#e0c1a3"
theme[free_mid]="#bdcd9c"
theme[free_end]="#faba72"

theme[cached_start]="#e0c1a3"
theme[cached_mid]="#bdcd9c"
theme[cached_end]="#faba72"

theme[available_start]="#e0c1a3"
theme[available_mid]="#bdcd9c"
theme[available_end]="#faba72"

theme[used_start]="#ffb4ab"
theme[used_mid]="#bdcd9c"
theme[used_end]="#faba72"

# Net download/upload graph colors
theme[download_start]="#e0c1a3"
theme[download_mid]="#bdcd9c"
theme[download_end]="#faba72"

theme[upload_start]="#e0c1a3"
theme[upload_mid]="#bdcd9c"
theme[upload_end]="#faba72"