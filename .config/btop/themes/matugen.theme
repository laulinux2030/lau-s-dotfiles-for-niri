# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#f1dfd8"

# Title color for boxes
theme[title]="#ffb595"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d2c78f"

# Background color of selected item in processes box
theme[selected_bg]="#713619"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffdbcc"

# Color of inactive/disabled text
theme[inactive_fg]="#a08d85"

# Color of graph background lines/borders
theme[proc_misc]="#52443d"

# Cpu box color gradient
theme[cpu_start]="#e6bead"
theme[cpu_mid]="#d2c78f"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#e6bead"
theme[free_mid]="#d2c78f"
theme[free_end]="#ffb595"

theme[cached_start]="#e6bead"
theme[cached_mid]="#d2c78f"
theme[cached_end]="#ffb595"

theme[available_start]="#e6bead"
theme[available_mid]="#d2c78f"
theme[available_end]="#ffb595"

theme[used_start]="#ffb4ab"
theme[used_mid]="#d2c78f"
theme[used_end]="#ffb595"

# Net download/upload graph colors
theme[download_start]="#e6bead"
theme[download_mid]="#d2c78f"
theme[download_end]="#ffb595"

theme[upload_start]="#e6bead"
theme[upload_mid]="#d2c78f"
theme[upload_end]="#ffb595"