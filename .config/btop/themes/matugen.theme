# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#e4e1e9"

# Title color for boxes
theme[title]="#c0c1ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e9b9d3"

# Background color of selected item in processes box
theme[selected_bg]="#3f4178"

# Foreground color of selected item in processes box
theme[selected_fg]="#e1e0ff"

# Color of inactive/disabled text
theme[inactive_fg]="#918f9a"

# Color of graph background lines/borders
theme[proc_misc]="#46464f"

# Cpu box color gradient
theme[cpu_start]="#c6c4dd"
theme[cpu_mid]="#e9b9d3"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#c6c4dd"
theme[free_mid]="#e9b9d3"
theme[free_end]="#c0c1ff"

theme[cached_start]="#c6c4dd"
theme[cached_mid]="#e9b9d3"
theme[cached_end]="#c0c1ff"

theme[available_start]="#c6c4dd"
theme[available_mid]="#e9b9d3"
theme[available_end]="#c0c1ff"

theme[used_start]="#ffb4ab"
theme[used_mid]="#e9b9d3"
theme[used_end]="#c0c1ff"

# Net download/upload graph colors
theme[download_start]="#c6c4dd"
theme[download_mid]="#e9b9d3"
theme[download_end]="#c0c1ff"

theme[upload_start]="#c6c4dd"
theme[upload_mid]="#e9b9d3"
theme[upload_end]="#c0c1ff"