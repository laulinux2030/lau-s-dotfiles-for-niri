# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#e2e2e9"

# Title color for boxes
theme[title]="#adc6ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#debcdf"

# Background color of selected item in processes box
theme[selected_bg]="#2b4678"

# Foreground color of selected item in processes box
theme[selected_fg]="#d8e2ff"

# Color of inactive/disabled text
theme[inactive_fg]="#8e9099"

# Color of graph background lines/borders
theme[proc_misc]="#44474f"

# Cpu box color gradient
theme[cpu_start]="#bfc6dc"
theme[cpu_mid]="#debcdf"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#bfc6dc"
theme[free_mid]="#debcdf"
theme[free_end]="#adc6ff"

theme[cached_start]="#bfc6dc"
theme[cached_mid]="#debcdf"
theme[cached_end]="#adc6ff"

theme[available_start]="#bfc6dc"
theme[available_mid]="#debcdf"
theme[available_end]="#adc6ff"

theme[used_start]="#ffb4ab"
theme[used_mid]="#debcdf"
theme[used_end]="#adc6ff"

# Net download/upload graph colors
theme[download_start]="#bfc6dc"
theme[download_mid]="#debcdf"
theme[download_end]="#adc6ff"

theme[upload_start]="#bfc6dc"
theme[upload_mid]="#debcdf"
theme[upload_end]="#adc6ff"