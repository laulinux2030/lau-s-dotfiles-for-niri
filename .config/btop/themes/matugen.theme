# Main background (auskommentiert/entfernt für Terminal-Transparenz)
# theme[main_bg] bleibt ungesetzt

# Main text color
theme[main_fg]="#f0dedd"

# Title color for boxes
theme[title]="#ffb3b0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e3c28c"

# Background color of selected item in processes box
theme[selected_bg]="#733332"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffdad8"

# Color of inactive/disabled text
theme[inactive_fg]="#a08c8b"

# Color of graph background lines/borders
theme[proc_misc]="#534342"

# Cpu box color gradient
theme[cpu_start]="#e6bdba"
theme[cpu_mid]="#e3c28c"
theme[cpu_end]="#ffb4ab"

# Mem/Disk meter colors
theme[free_start]="#e6bdba"
theme[free_mid]="#e3c28c"
theme[free_end]="#ffb3b0"

theme[cached_start]="#e6bdba"
theme[cached_mid]="#e3c28c"
theme[cached_end]="#ffb3b0"

theme[available_start]="#e6bdba"
theme[available_mid]="#e3c28c"
theme[available_end]="#ffb3b0"

theme[used_start]="#ffb4ab"
theme[used_mid]="#e3c28c"
theme[used_end]="#ffb3b0"

# Net download/upload graph colors
theme[download_start]="#e6bdba"
theme[download_mid]="#e3c28c"
theme[download_end]="#ffb3b0"

theme[upload_start]="#e6bdba"
theme[upload_mid]="#e3c28c"
theme[upload_end]="#ffb3b0"