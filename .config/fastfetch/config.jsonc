{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/lau/homefiles/avatar.jpg",
      "width": 27,
      "height": 12,
      "padding": {
        "top": 1,
        "bottom": 0,
        "left": 1,
        "right": 2  
      }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#b6d086",
      "title": "#c1caab"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#b6d086"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#b6d086"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#b6d086"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "#c1caab"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#c1caab"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#a0d0c9"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#a0d0c9"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#a0d0c9"
    },
    "break",
    "colors"
  ]
}